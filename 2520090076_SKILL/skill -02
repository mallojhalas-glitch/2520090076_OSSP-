#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <termios.h>

#define BUFFER_SIZE 100

// Function to read keyboard input character by character
void read_input(char *buffer)
{
    struct termios oldt, newt;
    char ch;
    int i = 0;

    // Get current terminal settings
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;

    // Disable canonical mode
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);

    while (1)
    {
        ch = getchar();

        // Enter key
        if (ch == '\n' || ch == '\r')
        {
            buffer[i] = '\0';
            printf("\n");
            break;
        }

        // Backspace key
        if (ch == 127 || ch == '\b')
        {
            if (i > 0)
            {
                i--;
                buffer[i] = '\0';

                // Remove character from terminal
                printf("\b \b");
                fflush(stdout);
            }
            continue;
        }

        // Store normal characters
        if (i < BUFFER_SIZE - 1)
        {
            buffer[i++] = ch;
            putchar(ch);
            fflush(stdout);
        }
    }

    // Restore terminal settings
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
}

int main()
{
    char input[BUFFER_SIZE];

    printf("Simple Interactive Shell\n");
    printf("Type 'exit' to terminate.\n\n");

    while (1)
    {
        // Display prompt
        printf("myshell> ");
        fflush(stdout);

        // Read user input
        read_input(input);

        // Handle empty input
        if (strlen(input) == 0)
        {
            continue;
        }

        // Handle exit condition
        if (strcmp(input, "exit") == 0)
        {
            printf("Shell terminated.\n");
            break;
        }

        // Display entered command
        printf("You entered: %s\n", input);
    }

    return 0;
}
