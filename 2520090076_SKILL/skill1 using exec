#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;

    printf("Parent process PID: %d\n", getpid());

    pid = fork();

    if (pid < 0)
    {
        printf("Fork failed\n");
        return 1;
    }
    else if (pid == 0)
    {
        // Child process
        printf("\nChild process created\n");
        printf("Child PID: %d\n", getpid());

        printf("Child is executing ls command using exec()\n");

        execlp("ls", "ls", "-l", NULL);

        // This executes only if exec() fails
        printf("exec failed\n");
    }
    else
    {
        // Parent process
        printf("\nParent is waiting for child...\n");

        wait(NULL);

        printf("Child completed execution\n");
        printf("Parent process completed\n");
    }

    return 0;
}
