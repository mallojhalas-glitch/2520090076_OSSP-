#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
#include <time.h>
#include <string.h>

int main() {
    int fd[2];
    pid_t pid;
    char message[] = "Hostel Room Data: Room 101 - Occupied";
    char buffer[100];

    struct timespec start, end;

    if (pipe(fd) == -1) {
        perror("pipe");
        return 1;
    }

    clock_gettime(CLOCK_MONOTONIC, &start);

    pid = fork();

    if (pid < 0) {
        perror("fork");
        return 1;
    }

    if (pid > 0) {
        // Parent = Producer
        close(fd[0]);

        write(fd[1], message, strlen(message) + 1);

        close(fd[1]);
        wait(NULL);

        clock_gettime(CLOCK_MONOTONIC, &end);

        double time_taken =
            (end.tv_sec - start.tv_sec) * 1e6 +
            (end.tv_nsec - start.tv_nsec) / 1e3;

        printf("\nCommunication completed.");
        printf("\nCommunication time: %.2f microseconds\n", time_taken);
    }
    else {
        // Child = Consumer
        close(fd[1]);

        read(fd[0], buffer, sizeof(buffer));

        printf("Child received: %s\n", buffer);

        close(fd[0]);
    }

    return 0;
}
